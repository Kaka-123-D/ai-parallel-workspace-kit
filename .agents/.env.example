# Copy thành `.agents/.env` rồi điền. File .env không commit, không copy vào worktree.
# Backlog — một space là đủ. Nhiều space: thêm BACKLOG_<NAME>_DOMAIN, BACKLOG_<NAME>_API_KEY, BACKLOG_<NAME>_PREFIXES.
BACKLOG_DOMAIN=<your-space>.backlog.com
BACKLOG_API_KEY=
# Slack (skill slack-context) — token phiên web, chỉ đọc. Cách lấy: xem SKILL.md.
SLACK_MCP_XOXC_TOKEN=
SLACK_MCP_XOXD_TOKEN=
